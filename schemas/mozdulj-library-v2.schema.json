{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mozdulj/schemas/library-v2",
  "title": "Mozdulj! – gyakorlattár export v2: beépített tartalomkorrektúrák",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "builtInCatalogVersion",
    "builtInSnapshot",
    "disabledBuiltInIds",
    "userExercises",
    "builtInContentOverrides"
  ],
  "properties": {
    "format": {
      "const": "mozdulj.library.v2"
    },
    "schemaVersion": {
      "const": 2
    },
    "exportedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "builtInCatalogVersion": {
      "type": "integer",
      "minimum": 1
    },
    "builtInSnapshot": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exerciseDraft"
      },
      "description": "Export másolat, importáláskor nem írja felül a telepített alapgyakorlatokat."
    },
    "disabledBuiltInIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "userExercises": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/userEntry"
      }
    },
    "builtInContentOverrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/builtInContentOverride"
      },
      "description": "Azonosítóhoz kötött helyi szöveg- és pózfelülírás. Importkor a beépített metaadat védett marad."
    }
  },
  "$defs": {
    "userEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercise",
        "status"
      ],
      "properties": {
        "exercise": {
          "$ref": "#/$defs/exerciseDraft"
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "disabled",
            "archived"
          ]
        },
        "createdAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "modifiedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exercise": {
                "$ref": "#/$defs/exerciseActive"
              }
            }
          }
        }
      ]
    },
    "exerciseDraft": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phase": {
          "type": "string"
        },
        "difficulty": {
          "type": "integer"
        },
        "measure": {
          "type": "string"
        },
        "targetSeconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "repTargets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repTarget"
          }
        },
        "estimatedSeconds": {
          "type": "integer"
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "startingPosition": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pose": {
          "$ref": "#/$defs/pose"
        }
      }
    },
    "exerciseActive": {
      "allOf": [
        {
          "$ref": "#/$defs/exerciseDraft"
        },
        {
          "type": "object",
          "required": [
            "id",
            "name",
            "category",
            "regions",
            "phase",
            "difficulty",
            "measure",
            "estimatedSeconds",
            "equipment"
          ],
          "properties": {
            "id": {
              "pattern": "^user-[A-Za-z0-9_-]+$"
            },
            "name": {
              "minLength": 1
            },
            "category": {
              "enum": [
                "mobilizálás",
                "erősítés",
                "nyújtás",
                "egyensúly",
                "relaxáció",
                "átmozgatás",
                "légzőgyakorlat"
              ]
            },
            "regions": {
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "phase": {
              "enum": [
                "warmup",
                "main",
                "cooldown"
              ]
            },
            "difficulty": {
              "minimum": 1,
              "maximum": 3
            },
            "estimatedSeconds": {
              "minimum": 5,
              "maximum": 3600
            },
            "measure": {
              "enum": [
                "time",
                "reps"
              ]
            }
          },
          "allOf": [
            {
              "anyOf": [
                {
                  "properties": {
                    "summary": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "summary"
                  ]
                },
                {
                  "properties": {
                    "steps": {
                      "type": "array",
                      "minItems": 1
                    }
                  },
                  "required": [
                    "steps"
                  ]
                }
              ]
            },
            {
              "if": {
                "properties": {
                  "measure": {
                    "const": "time"
                  }
                }
              },
              "then": {
                "properties": {
                  "targetSeconds": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 3600
                  },
                  "repTargets": {
                    "maxItems": 0
                  }
                },
                "required": [
                  "targetSeconds"
                ]
              },
              "else": {
                "properties": {
                  "targetSeconds": {
                    "type": "null"
                  },
                  "repTargets": {
                    "minItems": 1
                  }
                },
                "required": [
                  "repTargets"
                ]
              }
            }
          ]
        }
      ]
    },
    "repTarget": {
      "type": "object",
      "required": [
        "label",
        "count"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "pose": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "reviewStatus": {
          "enum": [
            "illustrative",
            "reviewed"
          ]
        },
        "view": {
          "enum": [
            "front",
            "side",
            "three-quarter"
          ]
        },
        "frames": {
          "type": "array",
          "anyOf": [
            {
              "maxItems": 0
            },
            {
              "minItems": 2,
              "maxItems": 6
            }
          ],
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "arrows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/arrow"
          }
        },
        "props": {
          "type": "array",
          "description": "Eszközök az egyes mozgásfázisokban, egységes rajzolóval (nem képfájl).",
          "items": {
            "$ref": "#/$defs/poseProp"
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "required": [
        "label",
        "joints"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "joints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head",
            "neck",
            "leftShoulder",
            "rightShoulder",
            "leftElbow",
            "rightElbow",
            "leftWrist",
            "rightWrist",
            "leftHip",
            "rightHip",
            "leftKnee",
            "rightKnee",
            "leftAnkle",
            "rightAnkle",
            "leftToe",
            "rightToe"
          ],
          "patternProperties": {
            ".*": {
              "$ref": "#/$defs/point"
            }
          }
        }
      }
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "z": {
          "type": "number",
          "minimum": -20,
          "maximum": 20
        }
      }
    },
    "arrow": {
      "type": "object",
      "required": [
        "frameIndex",
        "type",
        "startX",
        "startY",
        "endX",
        "endY"
      ],
      "properties": {
        "frameIndex": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "enum": [
            "line",
            "curve",
            "rotation"
          ]
        },
        "startX": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "startY": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "endX": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "endY": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "builtInContentOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exerciseId",
        "baseRevision",
        "summary",
        "startingPosition",
        "steps",
        "commonMistakes",
        "safetyNote",
        "pose"
      ],
      "properties": {
        "exerciseId": {
          "type": "string",
          "minLength": 1
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "startingPosition": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commonMistakes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safetyNote": {
          "type": "string",
          "minLength": 1
        },
        "pose": {
          "$ref": "#/$defs/pose"
        },
        "modifiedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "poseProp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameIndex",
        "kind",
        "x",
        "y",
        "scale"
      ],
      "properties": {
        "frameIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "kind": {
          "enum": [
            "jógamatrac",
            "szék",
            "gumiszalag",
            "kézisúlyzó",
            "fitball",
            "miniband",
            "SMR-henger",
            "jógablokk",
            "fal",
            "törölköző",
            "lépcső",
            "masszázslabda",
            "jógapánt"
          ]
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "scale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.6
        },
        "rotation": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "anchorA": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchorB": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
